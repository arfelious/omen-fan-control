#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PKG_DIR := debian/omen-fan-control-dkms
DKMS_REL := usr/src/hp-wmi-omen-1.0

%:
	dh $@

override_dh_auto_build:
	true

override_dh_auto_configure:
	true

override_dh_auto_clean:
	true

override_dh_auto_install:
	install -d "$(PKG_DIR)/$(DKMS_REL)"
	install -m644 ../../src/omen_fan_control/data/driver/dkms.conf "$(PKG_DIR)/$(DKMS_REL)/dkms.conf"
	sed -e 's/@PKGNAME@/hp-wmi-omen/g' -e 's/@PKGVER@/1.0/g' -i "$(PKG_DIR)/$(DKMS_REL)/dkms.conf"
	install -d "$(PKG_DIR)/$(DKMS_REL)/src"
	install -m644 ../../src/omen_fan_control/data/driver/src/Makefile "$(PKG_DIR)/$(DKMS_REL)/src/Makefile"
	cp -r ../../src/omen_fan_control/data/driver/hp-wmi-omen "$(PKG_DIR)/$(DKMS_REL)/src/"
