#!/bin/sh
set -e

case "$1" in
  configure)
    if command -v dkms >/dev/null 2>&1; then
      dkms remove hp-wmi-omen/1.0 --all 2>/dev/null || true
      dkms add hp-wmi-omen/1.0
      dkms build hp-wmi-omen/1.0 || echo "Warning: dkms build failed (kernel headers missing?)" >&2
      dkms install hp-wmi-omen/1.0 || echo "Warning: dkms install failed" >&2
    fi
    ;;
esac

exit 0
