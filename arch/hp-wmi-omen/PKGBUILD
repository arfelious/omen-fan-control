# DKMS kernel module: patched hp-wmi for HP Omen/Victus fan control (Linux < 6.20)
_pkgbase=hp-wmi-omen
pkgname="${_pkgbase}-dkms"
pkgver=1.0
pkgrel=1
pkgdesc="Patched hp-wmi driver for HP Omen/Victus fan control (DKMS; for kernels < 6.20)"
url="https://github.com/arfelious/omen-fan-control"
license=("GPL")
arch=("x86_64")
depends=("dkms" "linux-headers")
provides=("hp-wmi-omen")
install="${pkgname}.install"

source=("PKGBUILD")
sha256sums=("SKIP")

prepare() {
  local reporoot
  if [[ -f "$startdir/pyproject.toml" ]]; then
    reporoot="$startdir"
  else
    reporoot="$startdir/../.."
  fi
  mkdir -p "$srcdir/hp-wmi-omen"
  cp "$reporoot/src/omen_fan_control/data/driver/hp-wmi-omen/hp-wmi.c" "$srcdir/hp-wmi-omen/"
  cp "$reporoot/src/omen_fan_control/data/driver/hp-wmi-omen/Makefile" "$srcdir/hp-wmi-omen/"
  cp "$reporoot/src/omen_fan_control/data/driver/dkms.conf" "$srcdir/"
  cp "$reporoot/src/omen_fan_control/data/driver/src/Makefile" "$srcdir/"
}

package() {
  local dkms_dir="/usr/src/${_pkgbase}-${pkgver}"
  install -Dm644 dkms.conf "${pkgdir}${dkms_dir}/dkms.conf"
  sed -e 's/@PKGNAME@/hp-wmi-omen/g' -e 's/@PKGVER@/1.0/g' -i "${pkgdir}${dkms_dir}/dkms.conf"
  install -dm755 "${pkgdir}${dkms_dir}/src/hp-wmi-omen"
  install -m644 hp-wmi-omen/hp-wmi.c  "${pkgdir}${dkms_dir}/src/hp-wmi-omen/hp-wmi.c"
  install -m644 hp-wmi-omen/Makefile  "${pkgdir}${dkms_dir}/src/hp-wmi-omen/Makefile"
  install -m644 Makefile              "${pkgdir}${dkms_dir}/src/Makefile"
}
